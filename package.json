{
  "name": "keka-slack-middleware",
  "version": "1.0.0",
  "description": "Slack ↔ Keka attendance middleware",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/runMigrations.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "migrate:pg": "node scripts/runMigrationsPg.js",
    "seed:dev": "node scripts/seedDailyAttendance.js",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "@slack/web-api": "^6.13.0",
    "axios": "^1.13.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.8.0",
    "nodemon": "^3.0.3",
    "prettier": "^2.8.0",
    "supertest": "^6.3.3",
    "vitest": "^1.0.0"
  }
}
